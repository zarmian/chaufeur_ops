# Copy to `.env` and fill in. Never commit `.env`.
# Every variable the application reads is listed here.

# ---------------------------------------------------------------- database
# Supabase gives you two connection strings. Use the pooled one (port 6543,
# "Transaction" pooler) for the app, and the direct one (port 5432) for
# migrations — Prisma Migrate cannot run through pgbouncer.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------- auth
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Canonical origin of the deployment. Vercel sets this automatically in
# production; set it locally so callbacks resolve.
AUTH_URL="http://localhost:3000"
# Auth.js trusts the deployment host behind Vercel's proxy.
AUTH_TRUST_HOST="true"
# Database session lifetime in days.
SESSION_MAX_AGE_DAYS="30"

# --------------------------------------------------- file storage (R2)
# Cloudflare R2, S3-compatible. Bucket must NOT be publicly readable —
# every file is served through a short-lived signed URL.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Optional: override the endpoint (defaults to the R2 account endpoint).
R2_ENDPOINT=""

# ------------------------------------------------------------------- cron
# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# --------------------------------------------------------------- telegram
# Phase 5. Leave blank until then — the bot stays disabled without them.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# ------------------------------------------------------------------ email
# Phase 5. Transactional email for client messaging and invoice delivery.
EMAIL_API_KEY=""
EMAIL_FROM=""
