# Copy to `.env` and fill in. Never commit `.env`.
# Every variable the application reads is listed here.

# ---------------------------------------------------------------- database
# Supabase gives you two connection strings. Use the pooled one (port 6543,
# "Transaction" pooler) for the app, and the direct one (port 5432) for
# migrations — Prisma Migrate cannot run through pgbouncer.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------- auth
# Sessions live in the `Session` table and are keyed by a random token whose
# hash is what gets stored, so there is no signing secret to configure.
# Database session lifetime in days.
SESSION_MAX_AGE_DAYS="30"

# --------------------------------------------------- file storage (Blob)
# Vercel Blob, private. Driver licences and PHV badges are personal data, so
# every object is uploaded with access: 'private' and read through a
# short-lived signed URL — there is no public bucket to misconfigure.
# On Vercel this is injected by the Blob integration; locally, run
# `vercel env pull` to fetch it.
BLOB_READ_WRITE_TOKEN=""

# --------------------------------------------------------------------- pdf
# Invoices and driver statements are printed by headless Chromium.
# `@sparticuz/chromium` ships a Linux x64 build and unpacks itself into the
# function's temp directory, so on Vercel nothing needs setting here. Set this
# to a local Chrome or Chromium binary if you are developing on a machine that
# build does not run on — otherwise the PDF routes return 503 and point at the
# printable HTML version instead.
CHROMIUM_EXECUTABLE_PATH=""

# --------------------------------------------------------------- secrets
# Encrypts payment gateway and email credentials before they are written to
# the `Setting` table. Without it, saving a credential is refused rather than
# falling back to plaintext — a database backup must never contain a usable
# API key. Generate with: openssl rand -hex 32
#
# Changing it makes every stored credential unreadable; they have to be
# re-entered, which is by design.
SETTINGS_ENCRYPTION_KEY=""

# ------------------------------------------------------------------ setup
# Authorises the one-time /setup page on a fresh install. Optional — falls
# back to CRON_SECRET, so a new deployment needs no extra variable. Set it
# only if you would rather not share one secret between the bootstrap and
# the scheduler. /setup stops working the moment an administrator exists.
SETUP_TOKEN=""

# ------------------------------------------------------------------- cron
# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# --------------------------------------------------------------- telegram
# The driver bot. Optional, and off until enabled in Settings > Telegram —
# where the tokens are also entered and stored encrypted. These two are the
# fallback for a deployment that would rather hold secrets in Vercel than in
# Postgres.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_BOT_TOKEN=""

# Sent back by Telegram in `X-Telegram-Bot-Api-Secret-Token` on every update,
# and checked before the request body is read. The environment takes
# precedence over Settings here, because the webhook is registered against
# this value at deploy time and one that could change from a screen would
# silently break every future update.
#
# Without it the webhook refuses everything — which is the right state for a
# half-finished install, but does mean the bot goes quiet until it is set.
# Generate with: openssl rand -hex 32
#
# Register the webhooks after deploying:
#   curl -F "url=https://YOUR-HOST/api/telegram/webhook" \
#        -F "secret_token=$TELEGRAM_WEBHOOK_SECRET" \
#        https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook
#   curl -F "url=https://YOUR-HOST/api/telegram/admin-webhook" \
#        -F "secret_token=$TELEGRAM_WEBHOOK_SECRET" \
#        https://api.telegram.org/bot$TELEGRAM_ADMIN_BOT_TOKEN/setWebhook
TELEGRAM_WEBHOOK_SECRET=""

# ------------------------------------------------------- client messaging
# Booking confirmations and driver updates, by email and text. Configured in
# Settings > Client messaging, not here — the Twilio credentials are
# per-install and encrypted with SETTINGS_ENCRYPTION_KEY above.
#
# Every template is off by default, and each client carries their own
# preference — email, text, both or nothing. Both have to say yes.

# ------------------------------------------------------------------ email
# Optional. Used to email an invoice PDF to the billing address when it is
# sent. Without it, sending still marks the invoice sent and produces the PDF
# — the operator sends it themselves.
#
# Settings > Email takes precedence over these; they are the fallback for a
# deployment that would rather hold secrets in Vercel than in Postgres.
# Resend is assumed unless Settings says Postmark.
EMAIL_API_KEY=""
EMAIL_FROM=""

# -------------------------------------------------------- payment gateways
# Revolut Business and SumUp are configured in Settings > Payment gateways,
# not here — they are per-install choices, and the keys are encrypted with
# SETTINGS_ENCRYPTION_KEY above. Both are optional; recording a payment by
# hand works without either.
#
# Webhook endpoints, to give the provider:
#   /api/payments/webhooks/revolut
#   /api/payments/webhooks/sumup
# Each refuses every request until its signing secret is set in Settings.

# --------------------------------------------------------- address search
# Optional. Configured in Settings > Address search, not here — the Google
# Places key is per-install and is encrypted with SETTINGS_ENCRYPTION_KEY
# above, and the lookup is proxied through this application so the key never
# reaches a browser.
#
# With nothing configured the pickup and destination fields still offer
# saved locations and complete UK postcodes through api.postcodes.io, which
# needs no key and no billing.

# ------------------------------------------------------- bank statements
# Nothing to configure. Statements are uploaded as CSV in Reconciliation;
# the parser recognises the Barclays, HSBC, Lloyds, NatWest, Revolut
# Business and Starling export layouts, and asks which column is which for
# anything else.
