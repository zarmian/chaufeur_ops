{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && prisma migrate deploy && next build",
  "crons": [
    {
      "path": "/api/cron/housekeeping",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/unpriced-digest",
      "schedule": "0 7 * * 1-5"
    }
  ]
}
