// Schema implementing docs/data-model.md.
//
// Rules this file must never break:
//   * money is integer pence, columns suffixed `Pence` — never Float or Decimal
//   * timestamps are timestamptz stored in UTC, displayed in the configured zone
//   * every primary entity has `deletedAt` — there is no hard delete
//
// DATABASE_URL is the pooled connection (Supabase pooler, pgbouncer).
// DIRECT_URL is the direct 5432 connection, used for migrations only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- enums

enum UserRole {
  ADMIN
  OPS
  ACCOUNTS
  VIEWER
}

enum JobType {
  AS_DIRECTED
  TRANSFER
  AIRPORT_TRANSFER
  /// Contract hire: a car and driver held for a block of days at an agreed
  /// day rate. One job covering the whole block, not one per day — that is
  /// how the contract is agreed and how it is billed.
  CONTRACT
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum JobStatus {
  DRAFT
  PENDING
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum JobEventType {
  CREATED
  ASSIGNED
  ACCEPTED
  DECLINED
  ON_WAY
  ARRIVED
  POB
  COMPLETED
  CANCELLED
  NO_SHOW
  EDITED
  PRICE_SET
}

enum ActorType {
  USER
  DRIVER
  SYSTEM
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum VehicleStatus {
  ACTIVE
  OFF_ROAD
  RETIRED
}

enum VehicleClass {
  SALOON
  EXECUTIVE
  LUXURY
  MPV
  SUV
  ELECTRIC_EXECUTIVE
}

enum DocumentType {
  DVLA_LICENCE
  PHV_BADGE
  PHV_VEHICLE
  V5_LOGBOOK
  INSURANCE
  MOT
  DBS
  OTHER
}

enum PayStatus {
  UNPAID
  PARTIALLY_PAID
  FULLY_PAID
}

enum PayMethod {
  CASH
  CARD
  BANK_TRANSFER
  INVOICE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PART_PAID
  OVERDUE
  /// Fully reversed by a credit note. Distinct from PAID on purpose: no
  /// money arrived, and a ledger that called it paid would not reconcile
  /// against a bank statement. Distinct from CANCELLED too — the invoice was
  /// legitimately issued and the credit note is the document that undoes it.
  CREDITED
  CANCELLED
}

enum AccountKind {
  INTERNAL
  AGENCY
  CORPORATE
  INDIVIDUAL
}

enum PayoutStatus {
  DRAFT
  APPROVED
  PAID
}

/// How a driver is working at a given moment. Not a fixed property of the
/// person — the same driver can be an owner-driver one week and hired the
/// next. See DriverEngagement.
/// How a vehicle is held.
///
/// `DRIVER_OWNED` is the default because most of the fleet is owner-drivers'
/// cars — the company neither pays for them nor is entitled to their costs.
enum VehicleOwnership {
  OWNED
  FINANCED
  LEASED
  DRIVER_OWNED
}

/// What a vehicle cost was for.
enum VehicleCostKind {
  SERVICE
  REPAIR
  MOT_TEST
  TYRES
  BODYWORK
  CLEANING
  INSURANCE
  ROAD_TAX
  FINANCE
  LEASE
  BREAKDOWN_COVER
  PARKING_PERMIT
  OTHER
}

enum EngagementKind {
  /// Owns or leases their own car, paid a fee per job, bears their own
  /// running costs. The Phase 1/2 assumption, and the default.
  OWNER_DRIVER
  /// Drives a company car, paid by the hour for a shift. The company bears
  /// fuel and running costs.
  HIRED
}

/// Who ends up out of pocket for an expense.
enum ExpenseBearer {
  /// Recharged — appears on the client's bill.
  CLIENT
  /// The company absorbs it. A cost.
  COMPANY
  /// The driver absorbs it. Neither revenue nor cost to the company.
  DRIVER
}

enum RentalRateType {
  HOURLY
  DAILY
  WEEKLY
}

/// Who a vehicle went out to.
enum RenterType {
  DRIVER
  ACCOUNT
  EXTERNAL
}

enum RentalStatus {
  BOOKED
  ACTIVE
  RETURNED
  CANCELLED
}

/// Which end of the hire an inspection belongs to.
enum HandoverPhase {
  OUT
  IN
}

enum ExpenseKind {
  TOLL
  PARKING
  /// The barrier fee an airport charges to set down at the terminal. Kept
  /// apart from PARKING because it is the other charge that must never carry
  /// tax, and "parking" on a statement that means a drop-off barrier is how
  /// somebody later fails to spot it.
  DROPOFF_CHARGE
  FUEL
  CONGESTION_CHARGE
  ULEZ
  WAITING
  OTHER
}

/// How the agreed price relates to tax.
///
/// Not every job is tax-qualifying, and of the ones that are, some are priced
/// before tax and some after. One rate on the invoice header forced all three
/// into whichever the operator picked; see `lib/vat.ts`.
enum VatTreatment {
  /// The price is before tax. Tax is added to it.
  STANDARD
  /// The price already contains tax. It is shown separately, not added.
  INCLUSIVE
  /// Not tax-qualifying. Nothing is added.
  EXEMPT
}

// ------------------------------------------------------- people and access

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  role               UserRole  @default(VIEWER)
  active             Boolean   @default(true)
  /// Set when an administrator issues a temporary password. The dashboard
  /// refuses to render anything else until the user has chosen their own, so
  /// a password that passed through a third party is never the standing one.
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  /// Staff link their own Telegram for the admin bot — spec 5.9.1. Read-only
  /// there: somebody with a phone in a pub should be able to see whether
  /// tomorrow is covered, and should not be able to reassign a job.
  telegramChatId     BigInt?   @unique
  telegramLinkedAt   DateTime?
  createdAt          DateTime  @default(now())
  deletedAt          DateTime?

  auditEntries     AuditLog[]
  createdJobs      Job[]           @relation("JobCreatedBy")
  createdJobSeries JobSeries[]     @relation("JobSeriesCreatedBy")
  bulkOperations   BulkOperation[] @relation("BulkOperationCreatedBy")
  createdRentals   VehicleRental[] @relation("RentalCreatedBy")
  sessions         Session[]

  @@index([deletedAt])
}

/// Auth.js database sessions. The credentials provider issues an opaque
/// session token; the row here is the authority, so revoking access is a
/// delete rather than waiting for a JWT to expire.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

/// A bulk action over more than a handful of jobs — spec 6.5.4.
///
/// Small batches run inside the request and this table never sees them. Past
/// the threshold the work moves behind the response and its progress lives
/// here, because a request that spends two minutes applying a status change
/// to four hundred jobs is one the platform will cut off half way through —
/// leaving the operator with no idea which half.
///
/// The failures are kept per job, by reference. "Twelve refused" tells
/// somebody there is a problem without telling them where it is.
model BulkOperation {
  id     String              @id @default(cuid())
  kind   String
  status BulkOperationStatus @default(RUNNING)

  total     Int
  succeeded Int      @default(0)
  failed    Int      @default(0)
  /// One line per refusal: `WLX-000123: reason`.
  failures  String[]

  createdById String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  createdBy User? @relation("BulkOperationCreatedBy", fields: [createdById], references: [id])

  @@index([createdById, startedAt])
}

enum BulkOperationStatus {
  RUNNING
  DONE
  FAILED
}

/// Failed login attempts, keyed by IP, backing the 5-per-15-minutes limit.
model LoginAttempt {
  id          String   @id @default(cuid())
  ip          String
  email       String?
  successful  Boolean  @default(false)
  attemptedAt DateTime @default(now())

  @@index([ip, attemptedAt])
}

/// One row per limited request — spec 6.7.5.
///
/// In a table rather than in memory for the same reason `LoginAttempt` is:
/// Vercel runs many short-lived instances, and an in-process counter resets
/// on almost every request and therefore limits nothing.
model RateLimitEvent {
  id      String   @id @default(cuid())
  /// What is being limited, e.g. `export`. Separate buckets so a burst of
  /// spreadsheet downloads cannot lock somebody out of anything else.
  bucket  String
  /// Who: a user id where the request is authenticated, an IP where it is not.
  subject String
  at      DateTime @default(now())

  @@index([bucket, subject, at])
  @@index([at])
}

// ------------------------------------------------ commercial relationships

model Client {
  id               String         @id @default(cuid())
  name             String
  /// lowercase, punctuation stripped, honorifics removed — for dedupe
  normalisedName   String
  contactPhone     String?
  contactEmail     String?
  billingEmail     String?
  billingAddress   String?
  vatNumber        String?
  paymentTermsDays Int            @default(14)
  /// What this client's work is normally charged at. A job may override it.
  vatTreatment     VatTreatment   @default(STANDARD)
  /// How this client is kept informed — spec 5.10.4. `NONE` is a real
  /// choice: a corporate booker whose PA handles everything does not want
  /// four texts a day, and defaulting everybody to "both" is how a system
  /// gets muted.
  contactChannel   ContactChannel @default(EMAIL)
  defaultAccountId String?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  defaultAccount     Account?                  @relation(fields: [defaultAccountId], references: [id])
  jobs               Job[]
  invoices           Invoice[]
  bankTxns           BankTransaction[]
  credits            UnallocatedCredit[]
  messages           ClientMessage[]
  favouriteLocations ClientFavouriteLocation[]

  @@index([normalisedName])
  @@index([deletedAt])
}

/// The booker. Not the client — the client rides, the account placed the
/// booking and is usually who gets invoiced.
model Account {
  id               String      @id @default(cuid())
  name             String      @unique
  kind             AccountKind @default(INTERNAL)
  contactName      String?
  contactPhone     String?
  contactEmail     String?
  billingEmail     String?
  billingAddress   String?
  vatNumber        String?
  paymentTermsDays Int         @default(14)
  /// What this booker's work is normally charged at — an agency billing its
  /// own client gross wants INCLUSIVE, a non-registered partner EXEMPT. A job
  /// may override it.
  vatTreatment     VatTreatment @default(STANDARD)
  rateCardId       String?
  /// agency margin, not money — Decimal is correct here
  commissionPct    Decimal?    @db.Decimal(5, 2)
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  deletedAt        DateTime?

  rateCard RateCard?           @relation(fields: [rateCardId], references: [id])
  jobs     Job[]
  clients  Client[]
  invoices Invoice[]
  bankTxns BankTransaction[]
  credits  UnallocatedCredit[]
  rentals  VehicleRental[]

  @@index([deletedAt])
}

// ---------------------------------------------------- fleet and drivers

model Driver {
  id              String  @id @default(cuid())
  /// human-facing, e.g. DRV-0147
  reference       String  @unique
  name            String
  phone           String
  /// phone with spacing and international prefix folded away — the natural
  /// key a CSV re-import matches on, so the same file twice updates rather
  /// than duplicating.
  normalisedPhone String?
  email           String?
  address         String?

  dvlaLicenceNumber   String?
  dvlaLicenceExpiry   DateTime? @db.Date
  phvBadgeNumber      String?
  phvBadgeExpiry      DateTime? @db.Date
  phvIssuingAuthority String?

  assignedVehicleId String?
  telegramChatId    BigInt?   @unique
  telegramLinkedAt  DateTime?

  status    DriverStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  assignedVehicle Vehicle?           @relation(fields: [assignedVehicleId], references: [id])
  documents       Document[]
  jobs            Job[]
  payouts         DriverPayout[]
  bankTxns        BankTransaction[]
  linkTokens      LinkToken[]
  engagements     DriverEngagement[]
  shifts          DriverShift[]
  rentals         VehicleRental[]
  positions       DriverPosition[]
  ownedVehicles   Vehicle[]          @relation("VehicleOwner")

  @@index([status])
  @@index([phvBadgeExpiry])
  @@index([dvlaLicenceExpiry])
  @@index([normalisedPhone])
  @@index([deletedAt])
}

model Vehicle {
  id                     String       @id @default(cuid())
  registration           String       @unique
  /// registration with spaces stripped and uppercased — duplicate detection
  normalisedRegistration String       @unique
  make                   String
  model                  String
  variant                String?
  vehicleClass           VehicleClass @default(EXECUTIVE)
  colour                 String?
  seats                  Int          @default(4)

  phvLicenceNumber  String?
  phvLicenceExpiry  DateTime? @db.Date
  motExpiry         DateTime? @db.Date
  insuranceExpiry   DateTime? @db.Date
  insurancePolicyNo String?

  /// Printed on a hire contract, which has to identify the car precisely
  /// enough to be enforceable. Entered once per car rather than retyped onto
  /// every contract, where two versions of the same VIN would disagree.
  chassisNumber     String?
  firstRegisteredOn DateTime? @db.Date
  /// Agreed value, in pence. Stated on the acceptance of liability.
  valuePence        Int?
  insurerName       String?

  /// Most of the fleet belongs to its driver. Company cars are the exception,
  /// and the only ones whose running costs are the company's.
  ownership     VehicleOwnership @default(DRIVER_OWNED)
  /// Whose car it is, when it is not the company's.
  ownerDriverId String?

  acquiredOn         DateTime? @db.Date
  disposedOn         DateTime? @db.Date
  purchasePricePence Int?

  /// Latest known reading, updated whenever a cost records one.
  currentOdometer    Int?
  lastServicedOn     DateTime? @db.Date
  lastServiceMiles   Int?
  /// Nulls fall back to the configured fleet defaults.
  serviceEveryMonths Int?
  serviceEveryMiles  Int?

  status    VehicleStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  ownerDriver   Driver?               @relation("VehicleOwner", fields: [ownerDriverId], references: [id])
  costs         VehicleCost[]
  standingCosts VehicleStandingCost[]
  bankTxns      BankTransaction[]

  documents Document[]
  drivers   Driver[]
  jobs      Job[]
  shifts    DriverShift[]
  rentals   VehicleRental[]

  @@index([status])
  @@index([ownership])
  @@index([motExpiry])
  @@index([insuranceExpiry])
  @@index([phvLicenceExpiry])
  @@index([deletedAt])
}

model Document {
  id           String       @id @default(cuid())
  type         DocumentType
  driverId     String?
  vehicleId    String?
  /// R2 object key — never the binary itself
  fileKey      String
  fileName     String
  mimeType     String
  sizeBytes    Int
  issuedOn     DateTime?    @db.Date
  expiresOn    DateTime?    @db.Date
  uploadedById String?
  uploadedAt   DateTime     @default(now())
  /// points at the renewal that replaced this one
  supersededBy String?
  verifiedAt   DateTime?
  deletedAt    DateTime?

  driver  Driver?  @relation(fields: [driverId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([expiresOn])
  @@index([driverId, type])
  @@index([vehicleId, type])
  @@index([deletedAt])
}

// -------------------------------------------------- locations and pricing

model Location {
  id        String    @id @default(cuid())
  /// "Heathrow T5", "The Dorchester"
  label     String
  address   String
  postcode  String?
  zoneId    String?
  lat       Float?
  lng       Float?
  isAirport Boolean   @default(false)
  /// drives autocomplete ordering
  useCount  Int       @default(0)
  deletedAt DateTime?

  zone Zone? @relation(fields: [zoneId], references: [id])

  pickupForJobs  Job[]                     @relation("JobPickupLocation")
  dropoffForJobs Job[]                     @relation("JobDropoffLocation")
  stops          JobStop[]                 @relation("JobStopLocation")
  favouriteOf    ClientFavouriteLocation[]

  @@index([useCount])
  @@index([deletedAt])
}

/// A location a particular client uses — spec 6.4.6.
///
/// Offered first when that client is on the booking, ahead of the globally
/// popular ones. A corporate account whose people always go to the same
/// office should not have to scroll past Heathrow to find it, and the office
/// will never out-rank Heathrow on `useCount` across the whole business.
model ClientFavouriteLocation {
  clientId   String
  locationId String
  /// Free text, e.g. "Head office" or "Mr Ellis's home".
  note       String?
  createdAt  DateTime @default(now())

  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([clientId, locationId])
  @@index([locationId])
}

model Zone {
  id        String   @id @default(cuid())
  /// "Heathrow", "Gatwick", "Central London"
  name      String   @unique
  /// prefixes matched against pickup/dropoff postcodes
  postcodes String[]
  active    Boolean  @default(true)

  locations     Location[]
  rulesFromZone RateCardRule[] @relation("RuleFromZone")
  rulesToZone   RateCardRule[] @relation("RuleToZone")
}

model RateCard {
  id         String    @id @default(cuid())
  name       String
  activeFrom DateTime  @db.Date
  activeTo   DateTime? @db.Date
  isDefault  Boolean   @default(false)
  deletedAt  DateTime?

  rules    RateCardRule[]
  accounts Account[]

  @@index([deletedAt])
}

model RateCardRule {
  id           String        @id @default(cuid())
  rateCardId   String
  jobType      JobType
  /// null = any class
  vehicleClass VehicleClass?
  /// null = any origin
  fromZoneId   String?
  /// null = any destination
  toZoneId     String?

  baseFarePence      Int      @default(0)
  perHourPence       Int      @default(0)
  minimumHours       Decimal? @db.Decimal(4, 2)
  /// Contract work. A rule with a day rate prices a CONTRACT job the way
  /// `perHourPence` prices an as-directed one.
  perDayPence        Int      @default(0)
  minimumDays        Decimal? @db.Decimal(5, 2)
  freeWaitMinutes    Int      @default(15)
  waitPerMinutePence Int      @default(0)

  driverBasePence    Int      @default(0)
  driverPerHourPence Int      @default(0)
  /// alternative to a fixed driver rate — never both
  driverPctOfFare    Decimal? @db.Decimal(5, 2)

  /// higher wins when several rules match
  priority Int @default(0)

  rateCard RateCard @relation(fields: [rateCardId], references: [id])
  fromZone Zone?    @relation("RuleFromZone", fields: [fromZoneId], references: [id])
  toZone   Zone?    @relation("RuleToZone", fields: [toZoneId], references: [id])
  jobs     Job[]

  @@index([rateCardId, jobType])
}

// ------------------------------------------------------------------ jobs

model Job {
  id        String @id @default(cuid())
  /// WLX-000767 — prefix comes from settings, never hardcoded
  reference String @unique
  /// maps to a legacy #766 style id when one was imported
  legacyId  Int?   @unique

  clientId  String?
  accountId String?
  jobType   JobType
  status    JobStatus @default(PENDING)

  /// UTC. Displayed in the configured timezone. On a contract this is when
  /// the first day starts.
  scheduledAt      DateTime
  /// The last instant a CONTRACT job covers — the end of its final day, in
  /// the configured timezone. Null on every other type: one day's work ends
  /// when it ends, and an estimate is what says when.
  contractEndsAt   DateTime?
  estimatedMinutes Int?

  /// as typed
  pickupText        String
  pickupLocationId  String?
  /// From an address lookup. Feeds zone resolution, which is why it is on
  /// the job rather than only on the saved location — a one-off address
  /// still has to price correctly.
  pickupPostcode    String?
  pickupLat         Float?
  pickupLng         Float?
  dropoffText       String
  dropoffLocationId String?
  dropoffPostcode   String?
  dropoffLat        Float?
  dropoffLng        Float?
  viaText           String?

  driverId  String?
  vehicleId String?

  /// when different from the client
  passengerName  String?
  passengerPhone String?
  passengerCount Int?
  luggageCount   Int?
  flightNumber   String?

  /// captured at booking — the commercial agreement
  clientPricePence Int?
  driverPricePence Int?
  rateCardRuleId   String?
  /// required to complete a zero-value job
  zeroValueReason  String?
  /// Overrides the account's or client's treatment for this job alone. Null
  /// means "follow whoever is billed" — see `resolveVatTreatment`.
  vatTreatment     VatTreatment?

  notes         String?
  internalNotes String?

  /// Overrides the dated engagement for this job alone, for the case where
  /// someone covers a single run on different terms. Null = resolve from the
  /// driver's engagement at scheduledAt.
  engagementKind EngagementKind?
  /// Set when a hired driver's pay for this job is covered by a shift. The
  /// job then contributes no driver payment to its own gross profit.
  shiftId        String?

  /// The series this job was generated from — spec 6.3.4. Nullable, and the
  /// job is a complete booking without it: generation creates independent
  /// jobs, so a series that is later deleted leaves its jobs standing.
  seriesId      String?
  /// Position in the series, from 1. For display only — "this and future"
  /// filters on the date, because an individually-edited job may no longer
  /// sit where its index says.
  seriesIndex   Int?
  /// The outbound leg this job returns from — spec 6.3.2. Unique because one
  /// outbound has at most one return; booking a second is a new job, not a
  /// second link.
  returnOfJobId String? @unique

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  series          JobSeries?    @relation(fields: [seriesId], references: [id])
  returnOf        Job?          @relation("JobReturn", fields: [returnOfJobId], references: [id])
  returnJob       Job?          @relation("JobReturn")
  client          Client?       @relation(fields: [clientId], references: [id])
  account         Account?      @relation(fields: [accountId], references: [id])
  driver          Driver?       @relation(fields: [driverId], references: [id])
  vehicle         Vehicle?      @relation(fields: [vehicleId], references: [id])
  createdBy       User?         @relation("JobCreatedBy", fields: [createdById], references: [id])
  pickupLocation  Location?     @relation("JobPickupLocation", fields: [pickupLocationId], references: [id])
  dropoffLocation Location?     @relation("JobDropoffLocation", fields: [dropoffLocationId], references: [id])
  rateCardRule    RateCardRule? @relation(fields: [rateCardRuleId], references: [id])

  shift DriverShift? @relation(fields: [shiftId], references: [id])

  finance      JobFinance?
  events       JobEvent[]
  positions    DriverPosition[]
  expenses     JobExpense[]
  stops        JobStop[]
  invoiceLines InvoiceLine[]
  payoutLines  DriverPayoutLine[]

  @@index([scheduledAt])
  @@index([status, scheduledAt])
  @@index([contractEndsAt])
  @@index([driverId, scheduledAt])
  @@index([vehicleId, scheduledAt])
  @@index([clientId])
  @@index([accountId])
  @@index([shiftId])
  @@index([seriesId, scheduledAt])
  @@index([deletedAt])
}

/// A recurring booking — spec 6.3.3.
///
/// Holds the rule, not the jobs. Generation writes independent `Job` rows and
/// the series never rewrites them afterwards, because every one of them is a
/// real booking somebody may have already assigned a driver to. What the
/// series gives is the ability to find them together and act on them as a
/// group.
model JobSeries {
  id String @id @default(cuid())

  frequency RecurrenceFrequency
  /// Every N days, weeks or months.
  interval  Int                 @default(1)
  /// `WEEKLY` only: 0 = Sunday … 6 = Saturday.
  weekdays  Int[]

  /// The first occurrence. Its wall clock in the configured timezone fixes
  /// the time of day for the whole series — stored UTC instants drift by an
  /// hour across a DST transition, and the local time is what was agreed.
  startsAt    DateTime
  /// Exactly one of these two. A recurrence with neither is not a long
  /// series, it is an unanswered question.
  occurrences Int?
  endsOn      DateTime? @db.Date

  /// What was booked, in words, so the series list can describe itself
  /// without loading a job.
  label String

  /// Stops the series being offered for extension. The jobs it already
  /// generated are cancelled separately and individually, because each one
  /// is a booking a client may be expecting.
  cancelledAt DateTime?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  createdBy User? @relation("JobSeriesCreatedBy", fields: [createdById], references: [id])
  jobs      Job[]

  @@index([startsAt])
  @@index([deletedAt])
}

model JobFinance {
  id    String @id @default(cuid())
  jobId String @unique

  // Revenue
  baseFarePence        Int       @default(0)
  waitTimePence        Int       @default(0)
  waitMinutesBilled    Int       @default(0)
  /// Set when the driver's Arrived and POB taps produced the figure — spec
  /// 5.5.4. Its presence is what makes the field read-only on the panel: a
  /// number nobody typed should not be quietly retyped.
  waitAutoCalculatedAt DateTime?
  /// Who overrode the calculation, and why. Once set, the automatic figure
  /// stops writing — an accountant's reason beats the arithmetic.
  waitOverriddenById   String?
  waitOverriddenAt     DateTime?
  waitOverrideReason   String?
  extraChargesPence    Int       @default(0)
  extraChargesNotes    String?
  customerHours        Decimal?  @db.Decimal(5, 2)
  customerRatePence    Int       @default(0)
  /// Contract work, charged by the day. Kept apart from the hourly pair
  /// rather than reusing it: the free-wait allowance and the minimum-hours
  /// rule are about hours, and a day rate carrying them would be wrong in a
  /// way nobody would spot.
  customerDays         Decimal?  @db.Decimal(6, 2)
  customerDayRatePence Int       @default(0)
  totalClientPence     Int       @default(0)

  // Costs
  driverPaymentPence Int      @default(0)
  fuelCostPence      Int      @default(0)
  otherExpensesPence Int      @default(0)
  expenseNotes       String?
  driverHours        Decimal? @db.Decimal(5, 2)
  driverRatePence    Int      @default(0)
  /// What the driver is paid for a contract, by the day.
  driverDays         Decimal? @db.Decimal(6, 2)
  driverDayRatePence Int      @default(0)
  totalCostsPence    Int      @default(0)

  grossProfitPence Int @default(0)

  // Driver settlement
  driverPayStatus PayStatus  @default(UNPAID)
  driverPayMethod PayMethod?
  driverPaidAt    DateTime?
  paymentNotes    String?

  /// set once wait time is derived from ARRIVED -> POB events
  waitAutoCalculated Boolean @default(false)

  updatedAt DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id])

  @@index([driverPayStatus])
}

/// The append-only record of what happened and when. `jobs.status` is a
/// denormalised cache of the newest event, written in the same transaction.
model JobEvent {
  id         String       @id @default(cuid())
  jobId      String
  type       JobEventType
  actorType  ActorType
  /// user id or driver id
  actorId    String?
  occurredAt DateTime     @default(now())
  lat        Float?
  lng        Float?
  metadata   Json?

  job Job @relation(fields: [jobId], references: [id])

  @@index([jobId, occurredAt])
  @@index([type, occurredAt])
}

model JobExpense {
  id                  String        @id @default(cuid())
  jobId               String
  kind                ExpenseKind
  amountPence         Int
  note                String?
  receiptFileKey      String?
  submittedByDriverId String?
  approvedById        String?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?
  rechargeToClient    Boolean       @default(true)
  /// Who is out of pocket. CLIENT means recharged; COMPANY is a cost to us;
  /// DRIVER is neither. Defaults follow the engagement — the company bears
  /// fuel for a hired driver, the driver bears it when they own the car.
  borneBy             ExpenseBearer @default(COMPANY)
  createdAt           DateTime      @default(now())
  deletedAt           DateTime?

  job Job @relation(fields: [jobId], references: [id])

  @@index([jobId])
}

// ------------------------------------------------- commercial arrangements

/// How a driver is engaged over a period of time.
///
/// Dated rather than a column on Driver, because the terms change and a job
/// worked last March must still show the terms it was actually worked under.
/// A driver with no engagement row behaves exactly as in Phase 2.
model DriverEngagement {
  id       String         @id @default(cuid())
  driverId String
  kind     EngagementKind @default(OWNER_DRIVER)

  effectiveFrom DateTime  @db.Date
  /// null = still in force
  effectiveTo   DateTime? @db.Date

  /// HIRED only. Snapshotted onto each shift when it opens.
  hourlyRatePence  Int?
  dayRatePence     Int?
  /// Minutes past which the day counts as overtime, when a day rate applies.
  overtimeAfterMin Int?

  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  driver Driver @relation(fields: [driverId], references: [id])

  @@index([driverId, effectiveFrom])
  @@index([deletedAt])
}

/// A period a hired driver worked, which may cover several jobs or none.
///
/// The rate is copied in when the shift opens rather than read from the
/// engagement later: a rate rise must not silently re-price last month.
model DriverShift {
  id        String @id @default(cuid())
  /// human-facing, e.g. SHF-000123
  reference String @unique

  driverId  String
  vehicleId String?

  startedAt    DateTime
  /// null = still open
  endedAt      DateTime?
  /// Unpaid break, subtracted from the paid total.
  breakMinutes Int       @default(0)

  hourlyRatePence Int

  approvedById String?
  approvedAt   DateTime?

  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  driver      Driver             @relation(fields: [driverId], references: [id])
  vehicle     Vehicle?           @relation(fields: [vehicleId], references: [id])
  jobs        Job[]
  payoutLines DriverPayoutLine[]

  @@index([driverId, startedAt])
  @@index([endedAt])
  @@index([deletedAt])
}

/// An ordered stop between pickup and dropoff.
model JobStop {
  id       String @id @default(cuid())
  jobId    String
  /// 1-based position in the route.
  sequence Int

  address    String
  locationId String?

  arrivedAt   DateTime?
  departedAt  DateTime?
  waitMinutes Int?
  /// Revenue. Additional to any hourly or wait-time charge.
  chargePence Int?

  note      String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  job      Job       @relation(fields: [jobId], references: [id])
  location Location? @relation("JobStopLocation", fields: [locationId], references: [id])

  @@unique([jobId, sequence])
  @@index([jobId])
}

/// A company car hired out to a driver.
///
/// Deliberately not a Job. A rental has no pickup, no dropoff and no
/// passenger, spans days rather than minutes, and earns money with no
/// journey attached. Modelling it as a job would corrupt every job report.
/// A one-off cost against a vehicle — a service, a repair, a set of tyres.
model VehicleCost {
  id        String          @id @default(cuid())
  vehicleId String
  kind      VehicleCostKind

  amountPence Int
  incurredOn  DateTime @db.Date

  supplier       String?
  invoiceRef     String?
  /// Reading at the time, so servicing intervals can be judged on mileage.
  odometer       Int?
  receiptFileKey String?
  note           String?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, incurredOn])
  @@index([kind])
  @@index([deletedAt])
}

/// A cost that recurs — insurance, road tax, a finance or lease payment.
///
/// Held as an amount per period rather than as a stream of payments, and
/// accrued pro-rata across whatever window is being asked about. A £1,200
/// annual premium is £100 in a month; recording it as a single April payment
/// would make April look like a disaster and May look free.
model VehicleStandingCost {
  id        String          @id @default(cuid())
  vehicleId String
  kind      VehicleCostKind

  label        String
  /// The amount charged once per `periodMonths`.
  amountPence  Int
  periodMonths Int    @default(1)

  startsOn DateTime  @db.Date
  /// null = still running
  endsOn   DateTime? @db.Date

  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, startsOn])
  @@index([deletedAt])
}

model VehicleRental {
  id        String @id @default(cuid())
  /// human-facing, e.g. RNT-000042
  reference String @unique

  vehicleId  String
  /**
   * The renter, who is one of three things: a driver on the fleet, a company
   * with an account, or somebody with neither. All three sign the same
   * contract, so the hirer's details are resolved from whichever is set and
   * printed identically.
   */
  renterType RenterType @default(DRIVER)
  driverId   String?
  accountId  String?

  startAt    DateTime
  /// Planned return.
  endAt      DateTime
  /// Actual return. Charged to this when it is later than planned.
  returnedAt DateTime?

  rateType  RentalRateType @default(DAILY)
  ratePence Int
  /// Overrides the renter's treatment for this hire alone. Null follows the
  /// account, then the install default.
  vatTreatment VatTreatment?

  depositPence         Int       @default(0)
  depositReturnedPence Int       @default(0)
  depositReturnedAt    DateTime?

  mileageOut Int?
  mileageIn  Int?
  /// Fuel level as a percentage of a full tank.
  fuelOutPct Int?
  fuelInPct  Int?

  damageNotes       String?
  damageChargePence Int     @default(0)

  /**
   * The hirer, when they are neither a driver nor an account. A one-off hire
   * is still a contract, and a contract needs a name and an address.
   */
  hirerName          String?
  hirerAddress       String?
  hirerPhone         String?
  hirerLicenceNumber String?

  /**
   * What this particular contract says.
   * Held on the rental rather than in settings because they are negotiated
   * per hire — a long booking gets a bigger mileage allowance, a new customer
   * a larger deposit. Settings supply the defaults the form starts from; what
   * is stored here is what the signed contract said, so reprinting an old
   * contract cannot silently restate it at today's rates.
   */
  mileageAllowancePerDay Int?
  excessMileagePence     Int?
  advancePaymentPence    Int     @default(0)
  minimumTermDays        Int?
  insuranceExcessPence   Int?
  congestionChargePence  Int?
  smokingChargePence     Int?
  panelRepairPence       Int?
  wheelScratchPence      Int?
  depositReturnDays      Int?
  /// Who signs for the owner, and in what capacity.
  ownerSignatory         String?

  /// Set the first time a contract PDF is produced, so it is visible on the
  /// rental that one exists and when it was raised.
  contractGeneratedAt DateTime?

  status RentalStatus @default(BOOKED)
  notes  String?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  vehicle      Vehicle               @relation(fields: [vehicleId], references: [id])
  driver       Driver?               @relation(fields: [driverId], references: [id])
  account      Account?              @relation(fields: [accountId], references: [id])
  createdBy    User?                 @relation("RentalCreatedBy", fields: [createdById], references: [id])
  payments     RentalPayment[]
  checks       RentalChecklistItem[]
  invoiceLines InvoiceLine[]

  @@index([vehicleId, startAt])
  @@index([driverId])
  @@index([status])
  @@index([deletedAt])
}

/// Money received against a rental.
model RentalPayment {
  id       String @id @default(cuid())
  rentalId String

  amountPence Int
  paidAt      DateTime
  method      PayMethod?
  reference   String?
  note        String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  rental VehicleRental @relation(fields: [rentalId], references: [id])

  @@index([rentalId])
}

/// One line of the handover checklist, recorded at collection and at return.
model RentalChecklistItem {
  id       String        @id @default(cuid())
  rentalId String
  phase    HandoverPhase

  label String
  ok    Boolean @default(true)
  note  String?

  createdAt DateTime @default(now())

  rental VehicleRental @relation(fields: [rentalId], references: [id])

  @@index([rentalId, phase])
}

// ------------------------------------------------- invoicing and payouts

model Invoice {
  id        String   @id @default(cuid())
  /// INV-2026-0001 — prefix from settings
  number    String   @unique
  clientId  String?
  accountId String?
  issueDate DateTime @db.Date
  dueDate   DateTime @db.Date

  netPence   Int
  vatRatePct Decimal @default(20) @db.Decimal(5, 2)
  vatPence   Int
  grossPence Int
  paidPence  Int     @default(0)

  status           InvoiceStatus @default(DRAFT)
  notes            String?
  pdfFileKey       String?
  sentAt           DateTime?
  paidAt           DateTime?
  /// set on a credit note, pointing at the invoice it reverses
  creditsInvoiceId String?
  createdAt        DateTime      @default(now())
  deletedAt        DateTime?

  client      Client?          @relation(fields: [clientId], references: [id])
  account     Account?         @relation(fields: [accountId], references: [id])
  lines       InvoiceLine[]
  payments    Payment[]
  allocations BankAllocation[]

  /// The invoice this one reverses, and the credit notes reversing this one.
  /// The column existed without a relation, so nothing could ask "what has
  /// been credited against this invoice?" — which is why a credited invoice
  /// kept its full balance and went on being chased.
  credits     Invoice?  @relation("InvoiceCredit", fields: [creditsInvoiceId], references: [id])
  creditNotes Invoice[] @relation("InvoiceCredit")

  @@index([status, dueDate])
  @@index([creditsInvoiceId])
  @@index([deletedAt])
}

model InvoiceLine {
  id        String @id @default(cuid())
  invoiceId String

  jobId    String?
  /// Hire of one of the company's own cars. Rental income is revenue like any
  /// other, and without this it could be invoiced only as untraceable free
  /// text — nothing would tie the line back to the agreement it came from.
  rentalId String?

  /// The first line is the line's title; the rest is detail — the date, the
  /// pickup, the drop-off. Stored rather than derived from the job, because an
  /// invoice that has been sent must not change when somebody corrects the
  /// job it came from.
  description String
  /// The charge as agreed and as shown. Before tax under STANDARD, already
  /// containing it under INCLUSIVE.
  amountPence Int
  /// The part of `amountPence` that is passed through — parking, a drop-off
  /// charge, a toll. Never taxed under any treatment.
  disbursementPence Int @default(0)
  /// Snapshotted when the line is added. The invoice header keeps the rate;
  /// this is how the rate applies to this line.
  vatTreatment VatTreatment @default(STANDARD)
  /// What the quantity/rate columns show. Null on an ad-hoc line, which has
  /// only an amount — a made-up "1 × £45" is worse than no columns at all.
  quantity      Decimal? @db.Decimal(9, 2)
  quantityUnit  String?
  unitPricePence Int?
  sortOrder   Int    @default(0)

  invoice Invoice        @relation(fields: [invoiceId], references: [id])
  job     Job?           @relation(fields: [jobId], references: [id])
  rental  VehicleRental? @relation(fields: [rentalId], references: [id])

  @@index([invoiceId])
  @@index([jobId])
  @@index([rentalId])
}

model Payment {
  id           String   @id @default(cuid())
  invoiceId    String
  /// revolut | sumup | manual
  gateway      String
  gatewayTxnId String?
  amountPence  Int
  status       String
  receivedAt   DateTime
  raw          Json?

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

model DriverPayout {
  id               String       @id @default(cuid())
  driverId         String
  periodStart      DateTime     @db.Date
  periodEnd        DateTime     @db.Date
  totalPence       Int
  status           PayoutStatus @default(DRAFT)
  paidAt           DateTime?
  paymentReference String?
  statementFileKey String?
  createdAt        DateTime     @default(now())
  deletedAt        DateTime?

  driver      Driver             @relation(fields: [driverId], references: [id])
  lines       DriverPayoutLine[]
  allocations BankAllocation[]

  @@unique([driverId, periodStart, periodEnd])
  @@index([status])
}

model DriverPayoutLine {
  id       String @id @default(cuid())
  payoutId String

  /// A per-job fee. Null when the line is a shift.
  jobId   String?
  /// Hours worked in one of the company's own cars. Null when the line is a
  /// job. A driver paid by the hour has no per-job fee to pay out, so a
  /// payout that could only hold jobs could not pay them at all.
  shiftId String?

  amountPence Int
  description String?

  payout DriverPayout @relation(fields: [payoutId], references: [id])
  job    Job?         @relation(fields: [jobId], references: [id])
  shift  DriverShift? @relation(fields: [shiftId], references: [id])

  @@index([payoutId])
  @@index([jobId])
  @@index([shiftId])
}

// ---------------------------------------------------------------- system

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  /// "Job", "Invoice", ...
  entity    String
  entityId  String
  /// create | update | delete | restore
  action    String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model LinkToken {
  id        String    @id @default(cuid())
  token     String    @unique
  driverId  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  driver Driver @relation(fields: [driverId], references: [id])

  @@index([driverId])
}

// ------------------------------------------------- bank reconciliation

/// How a statement line was classified. `UNCLASSIFIED` is a first-class
/// state, not a failure: a line nobody has categorised must stay visible
/// rather than being guessed into a bucket to make the list look finished.
enum BankTxnKind {
  CLIENT_PAYMENT
  DRIVER_PAYOUT
  FUEL
  VEHICLE_COST
  RENTAL_INCOME
  /// Between the operator's own accounts. Neither income nor cost, and
  /// counting it would double every figure on the reports.
  TRANSFER
  UNCLASSIFIED
}

/// One CSV upload.
model BankStatement {
  id       String @id @default(cuid())
  /// The file as the operator named it, so they can tell two uploads apart.
  filename String
  /// Which bank's layout the parser matched, or `custom`.
  layout   String

  periodStart DateTime? @db.Date
  periodEnd   DateTime? @db.Date

  rowCount       Int @default(0)
  importedCount  Int @default(0)
  /// Rows skipped because they had already been imported.
  duplicateCount Int @default(0)

  uploadedById String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  transactions BankTransaction[]

  @@index([deletedAt])
}

model BankTransaction {
  id          String @id @default(cuid())
  statementId String

  occurredOn   DateTime @db.Date
  description  String
  /// Signed: negative is money out. Integer pence like everything else.
  amountPence  Int
  /// The bank's own reference where the export carries one.
  bankRef      String?
  balancePence Int?

  kind          BankTxnKind @default(UNCLASSIFIED)
  /// Set when a rule classified it, so a wrong rule can be traced back.
  matchedRuleId String?

  /// Who the money is from or to, once attributed. At most one is set.
  clientId  String?
  accountId String?
  driverId  String?
  vehicleId String?

  /// What was created from it, so an allocation can be undone.
  allocatedAt    DateTime?
  /// Sum of the allocations made from this transaction, in pence. Less than
  /// the amount when a credit exceeded what was owed.
  allocatedPence Int       @default(0)

  /**
   * Stable across re-imports of the same statement.
   * The bank's reference when there is one; otherwise a hash of the date,
   * amount and description. Uniqueness is what stops a second upload of an
   * overlapping period crediting every invoice twice.
   */
  fingerprint String @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  statement   BankStatement    @relation(fields: [statementId], references: [id])
  client      Client?          @relation(fields: [clientId], references: [id])
  account     Account?         @relation(fields: [accountId], references: [id])
  driver      Driver?          @relation(fields: [driverId], references: [id])
  vehicle     Vehicle?         @relation(fields: [vehicleId], references: [id])
  allocations BankAllocation[]

  @@index([statementId])
  @@index([kind, allocatedAt])
  @@index([occurredOn])
  @@index([deletedAt])
}

/// One transaction's money landing on one thing.
///
/// A row per invoice rather than a link per transaction, because a single
/// £1,000 credit routinely clears four invoices and leaves a fifth part
/// paid — and undoing it has to reverse exactly those five.
model BankAllocation {
  id            String @id @default(cuid())
  transactionId String

  invoiceId String?
  payoutId  String?
  costId    String?

  amountPence Int

  /// The `Payment` row this created, so undoing removes it.
  paymentId String?

  createdById String?
  createdAt   DateTime @default(now())

  transaction BankTransaction @relation(fields: [transactionId], references: [id])
  invoice     Invoice?        @relation(fields: [invoiceId], references: [id])
  payout      DriverPayout?   @relation(fields: [payoutId], references: [id])

  @@index([transactionId])
  @@index([invoiceId])
}

/// A phrase, and what it means. Nothing cleverer on purpose.
model BankRule {
  id String @id @default(cuid())

  /// Matched case-insensitively against the description.
  phrase String
  kind   BankTxnKind

  /// Optional: pin a matched transaction to a specific counterparty.
  clientId  String?
  accountId String?
  driverId  String?
  vehicleId String?

  /// Higher wins when two rules match the same description.
  priority Int     @default(0)
  active   Boolean @default(true)
  /// How many transactions this rule has classified, for pruning dead rules.
  hitCount Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([active, priority])
  @@index([deletedAt])
}

/// Money received that no invoice needed.
///
/// Kept rather than dropped: a client who overpays has a balance, and the
/// next invoice should be able to draw on it.
model UnallocatedCredit {
  id String @id @default(cuid())

  clientId      String?
  accountId     String?
  transactionId String?

  amountPence    Int
  /// Reduced as later invoices draw on it.
  remainingPence Int

  note      String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  client  Client?  @relation(fields: [clientId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])

  @@index([clientId])
  @@index([accountId])
  @@index([deletedAt])
}

// ------------------------------------------------------ telegram and messaging

/// Every inbound update, with what came of it — spec 5.1.7.
///
/// Kept because a bot that silently does nothing is indistinguishable from a
/// bot nobody messaged. When a driver says "I pressed Arrived", this is the
/// only place that can say whether the tap ever reached us.
///
/// The body is stored, not the whole update: a Telegram update carries the
/// user's display name and phone in places, and there is no reason to keep
/// more of it than the handler needed.
model TelegramUpdate {
  id String @id @default(cuid())

  /// `ops` or `admin` — which bot received it.
  bot       String
  chatId    BigInt?
  /// message | callback_query | photo | location | …
  kind      String
  /// The command or callback data, trimmed. Never the full message text.
  payload   String?
  driverId  String?
  userId    String?
  /// What the handler did, or the refusal.
  outcome   String
  handledMs Int?
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
  @@index([createdAt])
}

/// Where a driver was, while a job was live — spec 5.7.
///
/// Purged after the retention window rather than kept indefinitely. Knowing
/// where somebody was three months ago serves no operational purpose and is
/// the kind of data that only creates obligations.
model DriverPosition {
  id       String  @id @default(cuid())
  driverId String
  jobId    String?

  lat        Float
  lng        Float
  accuracyM  Int?
  headingDeg Int?
  recordedAt DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id])
  job    Job?   @relation(fields: [jobId], references: [id])

  @@index([driverId, recordedAt])
  @@index([jobId, recordedAt])
  @@index([recordedAt])
}

/// What a driver's chat is in the middle of.
///
/// Telegram has no notion of a form. A driver who sends a receipt photo has
/// to be asked what it was and how much, and the answer arrives as a separate
/// message with nothing tying it back. This is that thread.
///
/// One row per chat, replaced rather than accumulated, and expired so a
/// conversation abandoned yesterday does not capture an unrelated message
/// tomorrow.
model TelegramConversation {
  chatId BigInt @id

  /// `expense_kind` | `expense_amount` | `document_expiry` | …
  step      String
  /// What the step needs to remember: the job, the file key, the amount.
  context   Json
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

/// A client's standing preference for being contacted.
enum ContactChannel {
  EMAIL
  SMS
  BOTH
  NONE
}

/// How a client is contacted, and what was sent — spec 5.10.
enum MessageChannel {
  EMAIL
  SMS
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
}

/// One message to a client, and whether it arrived.
///
/// Mirrors what `TelegramUpdate` does for drivers: without it, "did the
/// client get the confirmation" has no answer but the client's word.
model ClientMessage {
  id       String  @id @default(cuid())
  clientId String?

  channel   MessageChannel
  /// booking_confirmation | driver_assigned | driver_en_route | invoice | …
  template  String
  /// Email address or phone number, as sent to.
  recipient String
  subject   String?
  body      String

  status       MessageStatus @default(QUEUED)
  /// The provider's own id, for chasing a delivery.
  providerId   String?
  failedReason String?
  sentAt       DateTime?
  createdAt    DateTime      @default(now())

  client Client? @relation(fields: [clientId], references: [id])

  @@index([clientId, createdAt])
  @@index([status])
}
